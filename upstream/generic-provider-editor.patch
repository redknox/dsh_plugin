diff --git a/packages/client/ui-settings-models/tests/generic-editor.client.spec.tsx b/packages/client/ui-settings-models/tests/generic-editor.client.spec.tsx
new file mode 100644
index 0000000..6d3c204
--- /dev/null
+++ b/packages/client/ui-settings-models/tests/generic-editor.client.spec.tsx
@@ -0,0 +1,373 @@
+// @vitest-environment jsdom
+/**
+ * Schema-driven generic provider editor (issue #14): unknown configurable
+ * providers render their own settings.describe schema as editable fields with
+ * the shared settings.mutate + credentials.set write path, unsupported
+ * constructs are surfaced explicitly, and the model field gains an optional
+ * discovery picker that degrades to plain text.
+ */
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import Schema from '@deepseek-ai/schemastery'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-test-runtime'
+import type { RpcResponse, SettingsNamespaceView } from '@deepseek-ai/dsh-api-remotes/client'
+import { ModelsSection } from '../src/client/ModelsSection.tsx'
+import type { ModelsSectionProps } from '../src/client/ModelsSection.tsx'
+import { SettingsDescribeMirror } from '@deepseek-ai/dsh-client-ui-settings/src/client/settings-mirror.ts'
+import { ModelsSettingsStore } from '../src/client/store.ts'
+import { en } from '../src/client/locales.ts'
+import { settingsSchema } from './settings-schema.client.ts'
+
+afterEach(cleanup)
+
+const t: ModelsSectionProps['t'] = key => en[key]
+
+/** The llama.cpp provider schema, as a third-party plugin would describe it. */
+const LlamacppConfig = Schema.object({
+  providerName: Schema.string().default('llama.cpp (Local Qwen3.8)')
+    .extra('extra', { ui: { label: 'Display name', description: 'Name shown in model selectors.' } }),
+  baseURL: Schema.string()
+    .extra('extra', { ui: { label: 'Base URL', description: 'OpenAI-compatible endpoint of the llama.cpp server.' } }),
+  model: Schema.string(),
+  apiKeyEnv: Schema.string().role('credential-ref'),
+  retries: Schema.number().step(1).min(0).default(3),
+  enabled: Schema.boolean().default(true),
+  preset: Schema.union(['off', 'low', 'medium', 'xhigh']).default('medium'),
+  reasoning: Schema.object({
+    enabled: Schema.boolean().default(true).extra('extra', { controls: ['preset'] }),
+    preset: Schema.union(['off', 'low', 'medium', 'xhigh']).default('medium'),
+  }).extra('extra', { ui: { label: 'Reasoning', collapsed: true } }),
+  // Unsupported constructs this editor must surface, never silently drop.
+  endpoints: Schema.array(Schema.string()),
+  anything: Schema.any(),
+})
+
+/** A wholly unrelated provider, proving the fallback is not llama.cpp-specific. */
+const SyntheticConfig = Schema.object({
+  displayName: Schema.string(),
+  enabled: Schema.boolean().default(false),
+  mode: Schema.union(['fast', 'slow']).default('fast'),
+  extra: Schema.dict(Schema.string()),
+})
+
+let nextRpc = 0
+function ok<T>(value: T): RpcResponse<T> {
+  return { rpcId: `r-${nextRpc++}` as never, result: { ok: true, value } }
+}
+function fail<T>(message: string, code: string): RpcResponse<T> {
+  return { rpcId: `r-${nextRpc++}` as never, result: { ok: false, error: { code, message, details: {} } as never } }
+}
+
+function namespaceView(ns: string, schema: Schema, value: Record<string, unknown>): SettingsNamespaceView {
+  return {
+    ns,
+    schema: JSON.parse(JSON.stringify(schema.toJSON())) as unknown,
+    value,
+    base: {},
+    user: {},
+    applies: 'live',
+    secrets: [],
+    revision: 0,
+  }
+}
+
+function scriptedFace(options: {
+  ns?: string
+  schema?: Schema
+  value?: Record<string, unknown>
+  provider?: string
+  discover?: ReturnType<typeof vi.fn>
+  mutate?: ReturnType<typeof vi.fn>
+  set?: ReturnType<typeof vi.fn>
+} = {}) {
+  const ns = options.ns ?? 'llm-llamacpp'
+  const provider = options.provider ?? 'llamacpp-local'
+  const value = options.value ?? { baseURL: 'http://10.0.0.1:8080', model: '/models/qwen.gguf' }
+  const namespace = namespaceView(ns, options.schema ?? LlamacppConfig, value)
+  const discover = options.discover ?? vi.fn(() => Promise.resolve(ok({ models: [] })))
+  const mutate = options.mutate ?? vi.fn(() => Promise.resolve(ok(namespace)))
+  const set = options.set ?? vi.fn(() => Promise.resolve(ok({})))
+  const face = {
+    llm: {
+      providers: vi.fn(() => Promise.resolve(ok({
+        providers: [{ provider, displayName: provider, settingsNs: ns, settingsPath: [], active: true }],
+      }))),
+      models: vi.fn(() => Promise.resolve(ok({ groups: [], failures: [] }))),
+      discoverModels: discover,
+    },
+    settings: {
+      describe: vi.fn(() => Promise.resolve(ok({ writable: true, namespaces: [namespace] }))),
+      update: vi.fn(),
+      replace: vi.fn(),
+      mutate,
+    },
+    credentials: {
+      describe: vi.fn((payload: { refs: string[] }) => Promise.resolve(ok({
+        credentials: Object.fromEntries(payload.refs.map(ref => [ref, { configured: false, writable: true }])),
+      }))),
+      set,
+      unset: vi.fn(),
+    },
+  }
+  return { face, discover, mutate, set, namespace }
+}
+
+type WireFace = ConstructorParameters<typeof ModelsSettingsStore>[0]
+
+interface MutateCall {
+  ns: string
+  expectedRevision?: number
+  ops: { op: string; path: string[]; value?: unknown }[]
+}
+
+function firstMutate(mutate: ReturnType<typeof vi.fn>): MutateCall {
+  const call = mutate.mock.calls[0]?.[0] as MutateCall | undefined
+  if (call === undefined) throw new Error('no settings write was recorded')
+  return call
+}
+
+async function mountSection(options: Parameters<typeof scriptedFace>[0] = {}) {
+  const scripted = scriptedFace(options)
+  const controller = new ModelsSettingsStore(
+    scripted.face as unknown as WireFace, settingsSchema, new SettingsDescribeMirror(scripted.face as never))
+  await controller.load()
+  const injected: ModelsSectionProps = {
+    controller,
+    useSnapshot: bindSnapshotSelector(controller.store),
+    api: scripted.face as never,
+    schema: settingsSchema,
+    t,
+  }
+  render(<ModelsSection {...injected} />)
+  return { ...scripted, controller }
+}
+
+/** Open the editor of one configured row (the generic card has no fold). */
+function openEditor(provider: string): void {
+  const row = screen.getByText(provider).closest('li')
+  if (row === null) throw new Error(`no row for ${provider}`)
+  const edit = [...row.querySelectorAll('button')].find(button => button.textContent === en.edit)
+  if (edit === undefined) throw new Error('no edit button')
+  fireEvent.click(edit)
+}
+
+describe('generic schema-driven provider editor (issue #14)', () => {
+  it('renders every supported primitive plus nested groups and keeps submit enabled', async () => {
+    const { mutate } = await mountSection()
+    openEditor('llamacpp-local')
+
+    // The credential field every card shares.
+    expect(screen.getByLabelText(en.keyInput)).toBeInstanceOf(HTMLInputElement)
+    // Strings render as text inputs named by their schema key.
+    for (const label of ['providerName', 'baseURL', 'model', 'apiKeyEnv']) {
+      expect(screen.getByLabelText(label)).toBeInstanceOf(HTMLInputElement)
+    }
+    // Booleans and enums render as selects.
+    expect(screen.getByLabelText('enabled')).toBeInstanceOf(HTMLSelectElement)
+    expect(screen.getByLabelText('preset')).toBeInstanceOf(HTMLSelectElement)
+    // The preset select offers the schema's union choices.
+    const preset = screen.getByLabelText('preset') as HTMLSelectElement
+    expect([...preset.options].map(option => option.value)).toEqual(['off', 'low', 'medium', 'xhigh'])
+    // Numbers render as numeric text inputs.
+    expect(screen.getByLabelText('retries')).toBeInstanceOf(HTMLInputElement)
+    // The nested reasoning group is a collapsible section with its own fields,
+    // addressed by their dotted paths so they never collide with the
+    // top-level namesakes.
+    expect(screen.getByLabelText('reasoning.enabled')).toBeInstanceOf(HTMLSelectElement)
+    expect(screen.getByLabelText('reasoning.preset')).toBeInstanceOf(HTMLSelectElement)
+    // Unsupported constructs are surfaced explicitly, never as editable fields.
+    expect(screen.getAllByText(en.genericUnsupported).length).toBeGreaterThan(0)
+    const submit = [...document.querySelectorAll('button')].find(button => button.textContent === en.apply)
+    expect(submit?.disabled).toBe(false)
+  })
+
+  it('saves a string edit as a minimal path op (no rebuild, no dropped fields)', async () => {
+    const { mutate } = await mountSection()
+    openEditor('llamacpp-local')
+
+    fireEvent.change(screen.getByLabelText('providerName'), { target: { value: 'Local Qwen' } })
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    expect(firstMutate(mutate)).toMatchObject({
+      ns: 'llm-llamacpp',
+      expectedRevision: 0,
+      ops: [{ op: 'set', path: ['providerName'], value: 'Local Qwen' }],
+    })
+  })
+
+  it('saves enum and boolean choices', async () => {
+    const { mutate } = await mountSection()
+    openEditor('llamacpp-local')
+
+    fireEvent.change(screen.getByLabelText('preset'), { target: { value: 'low' } })
+    fireEvent.change(screen.getByLabelText('enabled'), { target: { value: 'disabled' } })
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    // Path ops follow the draft's key order (the order fields were edited).
+    expect(firstMutate(mutate).ops).toEqual([
+      { op: 'set', path: ['preset'], value: 'low' },
+      { op: 'set', path: ['enabled'], value: false },
+    ])
+  })
+
+  it('saves fields inside a nested object as one subtree op (reasoning.enabled/preset)', async () => {
+    const { mutate } = await mountSection()
+    openEditor('llamacpp-local')
+
+    fireEvent.change(screen.getByLabelText('reasoning.enabled'), { target: { value: 'disabled' } })
+    fireEvent.change(screen.getByLabelText('reasoning.preset'), { target: { value: 'low' } })
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    // The whole reasoning subtree travels as one path op, like the curated
+    // families' models arrays — minimal, and nothing outside the card is
+    // rebuilt or dropped.
+    expect(firstMutate(mutate).ops).toEqual([
+      { op: 'set', path: ['reasoning'], value: { enabled: false, preset: 'low' } },
+    ])
+  })
+
+  it('fills the model field from discovery and degrades to plain text on failure', async () => {
+    const discover = vi.fn(() => Promise.resolve(ok({ models: [{ id: '/models/qwen.gguf', contextWindow: 204800 }] })))
+    const { mutate } = await mountSection({ discover })
+    openEditor('llamacpp-local')
+
+    // Success: pick a candidate; the field is filled and saved.
+    fireEvent.click(screen.getByText(en.genericModelFetch))
+    await waitFor(() => { expect(screen.getByText('/models/qwen.gguf')).toBeDefined() })
+    fireEvent.click(screen.getByText('/models/qwen.gguf'))
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    expect(firstMutate(mutate).ops).toEqual([{ op: 'set', path: ['model'], value: '/models/qwen.gguf' }])
+
+    // The probe carried the namespace and route, plus the shown base URL.
+    const probe = (discover.mock.calls[0]?.[0] as { settingsNs: string; provider: string; baseURL: string })
+    expect(probe).toMatchObject({ settingsNs: 'llm-llamacpp', provider: 'llamacpp-local', baseURL: 'http://10.0.0.1:8080' })
+  })
+
+  it('surfaces discovery failure next to a still-usable text field', async () => {
+    const discover = vi.fn(() => Promise.resolve(fail('no model discovery is registered for "llm-llamacpp"', 'NO_DISCOVERY')))
+    await mountSection({ discover })
+    openEditor('llamacpp-local')
+
+    fireEvent.click(screen.getByText(en.genericModelFetch))
+    await waitFor(() => { expect(screen.getByText(/no model discovery/)).toBeDefined() })
+    // The plain text input remains editable.
+    const input = screen.getByLabelText('model') as HTMLInputElement
+    fireEvent.change(input, { target: { value: 'manual-model' } })
+    expect(input.value).toBe('manual-model')
+  })
+
+  it('keeps the credential off the settings document (credentials.set only)', async () => {
+    const { mutate, set } = await mountSection()
+    openEditor('llamacpp-local')
+
+    // A settings field edit plus a key: the key must travel through the
+    // credentials seam, never as a settings op.
+    fireEvent.change(screen.getByLabelText('providerName'), { target: { value: 'Local Qwen' } })
+    const keyInput = screen.getByLabelText(en.keyInput) as HTMLInputElement
+    fireEvent.change(keyInput, { target: { value: 'sk-draft-secret' } })
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    expect(set).toHaveBeenCalledWith({ ref: 'LLAMACPP_LOCAL_API_KEY', value: 'sk-draft-secret' })
+    const written = JSON.stringify(firstMutate(mutate).ops)
+    expect(written).not.toContain('sk-draft-secret')
+  })
+
+  it('disables a switch-controlled sibling while the master switch is off', async () => {
+    await mountSection()
+    openEditor('llamacpp-local')
+
+    const preset = screen.getByLabelText('reasoning.preset') as HTMLSelectElement
+    expect(preset.disabled).toBe(false)
+    // `.extra('controls', ['preset'])` on reasoning.enabled: flipping the
+    // switch off locks the preset it would otherwise ignore.
+    fireEvent.change(screen.getByLabelText('reasoning.enabled'), { target: { value: 'disabled' } })
+    expect((screen.getByLabelText('reasoning.preset') as HTMLSelectElement).disabled).toBe(true)
+    // Flipping it back re-enables the sibling.
+    fireEvent.change(screen.getByLabelText('reasoning.enabled'), { target: { value: 'enabled' } })
+    expect((screen.getByLabelText('reasoning.preset') as HTMLSelectElement).disabled).toBe(false)
+  })
+
+  it('renders and saves an unrelated configurable provider (not llama.cpp-specific)', async () => {
+    const { mutate } = await mountSection({
+      ns: 'llm-synthetic',
+      provider: 'synthetic-local',
+      schema: SyntheticConfig,
+      value: { displayName: 'Acme', enabled: true, mode: 'fast' },
+    })
+    openEditor('synthetic-local')
+
+    expect(screen.getByLabelText('displayName')).toBeInstanceOf(HTMLInputElement)
+    expect(screen.getByLabelText('enabled')).toBeInstanceOf(HTMLSelectElement)
+    expect(screen.getByLabelText('mode')).toBeInstanceOf(HTMLSelectElement)
+    // A dict construct is unsupported and surfaced, not silently dropped.
+    expect(screen.getAllByText(en.genericUnsupported).length).toBeGreaterThan(0)
+
+    fireEvent.change(screen.getByLabelText('mode'), { target: { value: 'slow' } })
+    fireEvent.click(screen.getByText(en.apply))
+    await waitFor(() => { expect(mutate).toHaveBeenCalled() })
+    expect(firstMutate(mutate)).toMatchObject({
+      ns: 'llm-synthetic',
+      ops: [{ op: 'set', path: ['mode'], value: 'slow' }],
+    })
+  })
+})
+
+describe('semantic groups and field help (issue #19)', () => {
+  it('keeps basic fields visible and renders object fields as collapsed groups', async () => {
+    await mountSection()
+    openEditor('llamacpp-local')
+
+    // Top-level scalar fields are immediately visible (the Basic area).
+    expect(screen.getByLabelText('baseURL')).toBeInstanceOf(HTMLInputElement)
+    expect(screen.getByLabelText('providerName')).toBeInstanceOf(HTMLInputElement)
+    // The reasoning object is a group declared collapsed via ui metadata.
+    const summaries = [...document.querySelectorAll('summary')].map(s => s.textContent)
+    expect(summaries).toContain('Reasoning')
+    const group = [...document.querySelectorAll('details')]
+      .find(d => d.querySelector('summary')?.textContent === 'Reasoning')
+    expect(group).toBeDefined()
+    expect(group?.hasAttribute('open')).toBe(false)
+    // Group members still exist in the DOM (hidden) and keep their labels.
+    expect(screen.getByLabelText('reasoning.enabled')).toBeInstanceOf(HTMLSelectElement)
+    // Expanding the group makes its fields reachable like before.
+    fireEvent.click(screen.getByText('Reasoning'))
+    expect(group?.hasAttribute('open')).toBe(true)
+  })
+
+  it('renders ui.label and ui.description for fields', async () => {
+    await mountSection()
+    openEditor('llamacpp-local')
+
+    // The label override replaces the schema key as the visible name.
+    expect(screen.getByText('Display name')).toBeDefined()
+    expect(screen.getByText('Base URL')).toBeDefined()
+    // The concise description is rendered near the control.
+    expect(screen.getByText('Name shown in model selectors.')).toBeDefined()
+    expect(screen.getByText('OpenAI-compatible endpoint of the llama.cpp server.')).toBeDefined()
+    // The accessible name stays the dotted path (stable for tests/AT).
+    expect(screen.getByLabelText('providerName')).toBeInstanceOf(HTMLInputElement)
+  })
+
+  it('degrades to the current behavior when a provider supplies no ui metadata', async () => {
+    await mountSection({
+      ns: 'llm-plain-no-ui',
+      provider: 'plain-no-ui',
+      schema: Schema.object({
+        note: Schema.string(),
+        nested: Schema.object({ flag: Schema.boolean().default(true) }),
+      }),
+      value: {},
+    })
+    openEditor('plain-no-ui')
+
+    // No labels/descriptions: schema keys shown (humanized for groups).
+    expect(screen.getByLabelText('note')).toBeInstanceOf(HTMLInputElement)
+    const summaries = [...document.querySelectorAll('summary')].map(s => s.textContent)
+    expect(summaries).toContain('Nested') // humanized key, default expanded
+    const group = [...document.querySelectorAll('details')]
+      .find(d => d.querySelector('summary')?.textContent === 'Nested')
+    expect(group?.hasAttribute('open')).toBe(true)
+    expect(screen.getByLabelText('nested.flag')).toBeInstanceOf(HTMLSelectElement)
+  })
+})
