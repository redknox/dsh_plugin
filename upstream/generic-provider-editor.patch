@@ -0,0 +1,535 @@
+/**
+ * Schema-driven editor for configurable providers the Models page has no
+ * curated family for (issue #14). Renders the provider's own
+ * `settings.describe` schema — strings, booleans, enum/union choices,
+ * numbers, and simple nested objects — inside the shared ProviderEditor card,
+ * so the credential field and the settings.mutate + credentials.set write
+ * path stay the single, unchanged mechanism for every provider.
+ *
+ * Unsupported schema constructs (arrays, dicts, transforms, heterogeneous
+ * unions, …) are surfaced explicitly with an "edit in settings.yaml" hint
+ * rather than being silently dropped on save: this editor never renders a
+ * control it cannot faithfully write, so a field it shows is always saved
+ * exactly as displayed, and a field it does not show is never deleted by a
+ * rebuild.
+ *
+ * A `model` string field gains an optional discovery-backed picker
+ * (`llm.discoverModels`, the seam providers register through
+ * `ctx.llm.registerModelDiscovery`). Discovery is strictly additive: on
+ * success the picked id fills the field; on failure or when no discovery is
+ * registered the plain text input remains fully usable.
+ */
+
+import { useState } from 'react'
+import type { ReactNode } from 'react'
+import type { IApiClient, SettingsNamespaceView } from '@deepseek-ai/dsh-api-remotes/client'
+import type { SchemaNode } from '@deepseek-ai/dsh-client-ui-settings/client'
+import type { SettingsSchemaOperations } from './schema-operations.ts'
+import type { ProbeTarget } from './ModelListEditor.tsx'
+import { messageOf } from './store.ts'
+import type { en } from './locales.ts'
+import styles from './ModelsSection.module.css'
+
+/** Props of {@link GenericSchemaEditor}. */
+export interface GenericSchemaEditorProps {
+  /** Provider route id, sent with discovery probes. */
+  provider: string
+  /** The owning namespace view (schema, layers, secrets). */
+  namespace: SettingsNamespaceView
+  /** Settings-owned synchronous schema and immutable path operations. */
+  schema: SettingsSchemaOperations
+  /** Rehydrated schema node at the edited subtree. */
+  node: SchemaNode
+  /** Draft of the user-layer subtree this editor edits. */
+  draft: Record<string, unknown>
+  /** Replace the drafted subtree. */
+  setDraft: (updater: (current: Record<string, unknown>) => Record<string, unknown>) => void
+  /** Effective (layered) value of the edited subtree, for placeholders. */
+  fallback: unknown
+  /** Endpoint facts for the model fetch action, owned by the card. */
+  probe: ProbeTarget
+  /** Wire face the fetch action calls. */
+  api: Pick<IApiClient, 'llm'>
+  /** Disable every control (read-only deployment or a pending write). */
+  disabled: boolean
+  /** Section copy. */
+  t: (key: keyof typeof en) => string
+}
+
+/** Enum choices of a union-of-string-literals node, or undefined. */
+function enumChoices(field: SchemaNode): readonly string[] | undefined {
+  if (field.type !== 'union' || field.list === undefined) return undefined
+  const choices: string[] = []
+  for (const member of field.list) {
+    if (member.type !== 'const' || typeof member.value !== 'string') return undefined
+    choices.push(member.value)
+  }
+  return choices
+}
+
+/** Whether this schema node is one this editor can render faithfully. */
+function isEditableType(field: SchemaNode): boolean {
+  switch (field.type) {
+    case 'string':
+    case 'boolean':
+    case 'number':
+    case 'object':
+      return true
+    case 'union':
+      return enumChoices(field) !== undefined
+    default:
+      return false
+  }
+}
+
+/**
+ * Sibling fields a boolean master switch disables while it is off, declared
+ * through Schemastery's generic `.extra('extra', {controls: [...]})`
+ * metadata. The mechanism is schema-driven, not provider-specific: any
+ * configurable provider can mark one boolean as controlling siblings (e.g.
+ * `reasoning.enabled` → `['preset']`), and the editor applies it.
+ */
+function controlsOf(field: SchemaNode): readonly string[] | undefined {
+  const extra = (field.meta as { extra?: unknown }).extra
+  if (typeof extra !== 'object' || extra === null) return undefined
+  const controls = (extra as { controls?: unknown }).controls
+  return Array.isArray(controls) && controls.every((entry) => typeof entry === 'string')
+    ? controls as string[]
+    : undefined
+}
+
+/**
+ * Advisory presentation metadata (issue #19), declared by providers through
+ * Schemastery's generic `.extra('extra', {ui: {...}})` slot — never
+ * hard-coded per family:
+ *
+ *   z.object({...}).extra('extra', { ui: { label: 'Reliability', collapsed: true } })
+ *   baseURL: z.string().extra('extra', { ui: { label: 'Base URL', description: '…' } })
+ *
+ * - `label` — human-readable name shown instead of the schema key.
+ * - `description` — one short line of user-facing help, rendered under the
+ *   control (longer text should stay in the schema `comment`/tooltip).
+ * - `collapsed` — an object field (a semantic group) starts collapsed.
+ */
+export interface UiMeta {
+  label?: string
+  description?: string
+  collapsed?: boolean
+}
+
+/** Read a node's advisory UI metadata; absent/malformed → undefined (fall back). */
+function uiOf(field: SchemaNode): UiMeta | undefined {
+  const extra = (field.meta as { extra?: unknown }).extra
+  if (typeof extra !== 'object' || extra === null) return undefined
+  const ui = (extra as { ui?: unknown }).ui
+  if (typeof ui !== 'object' || ui === null) return undefined
+  return ui as UiMeta
+}
+
+/** `retryPolicy` → `Retry Policy`; fallback label for groups without ui.label. */
+function humanize(name: string): string {
+  return name
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/^./, (ch) => ch.toUpperCase())
+}
+
+/** The effective boolean of a switch field, mirroring the boolean branch. */
+function effectiveBoolean(value: unknown, fallback: unknown, field: SchemaNode): boolean {
+  if (typeof value === 'boolean') return value
+  if (typeof fallback === 'boolean') return fallback
+  if (typeof field.meta.default === 'boolean') return field.meta.default
+  return true
+}
+
+/**
+ * One schema-driven field. Every control writes through `setNested` path ops
+ * so nested objects (e.g. a `reasoning` group) commit exactly like top-level
+ * ones, and clearing a value unsets the path instead of storing an empty
+ * placeholder.
+ */
+function FieldEditor(props: {
+  name: string
+  field: SchemaNode
+  path: readonly string[]
+  value: unknown
+  fallback: unknown
+  setNested: (path: readonly string[], value: unknown) => void
+  disabled: boolean
+  owner: GenericSchemaEditorProps
+}): ReactNode {
+  const { name, field, path, value, fallback, setNested, disabled, owner } = props
+  const { schema, probe, api, t } = owner
+  const ui = uiOf(field)
+  // The accessible name is the full dotted path so nested groups (e.g. a
+  // `reasoning` object) never collide with their top-level namesakes.
+  const ariaLabel = path.join('.')
+  const displayName = ui?.label ?? name
+  const label = (
+    <span className={styles['fieldLabel']}>
+      {displayName}
+      {' '}
+      <span className={styles['modelCatalogMeta']}>
+        {field.meta.required === true ? t('genericRequired') : t('genericOptional')}
+      </span>
+    </span>
+  )
+  // One short line of user-facing help, rendered under the control.
+  const help = ui?.description === undefined || ui.description.length === 0
+    ? null
+    : <p className={styles['advancedHint']}>{ui.description}</p>
+  const placeholder = typeof fallback === 'string' && fallback.length > 0
+    ? fallback
+    : typeof field.meta.default === 'string'
+      ? field.meta.default
+      : ''
+
+  if (!isEditableType(field)) {
+    // Explicit, never silent: the field survives untouched in settings.yaml
+    // and the user is told where it lives.
+    return (
+      <div className={styles['field']}>
+        {label}
+        <p className={styles['advancedHint']}>{t('genericUnsupported')}</p>
+        {help}
+      </div>
+    )
+  }
+
+  if (field.type === 'string') {
+    const text = typeof value === 'string' ? value : ''
+    const editable = disabled || field.meta.disabled === true
+    const input = (
+      <input
+        className={styles['input']}
+        type="text"
+        value={text}
+        placeholder={placeholder}
+        aria-label={ariaLabel}
+        disabled={editable}
+        onChange={(event) => {
+          const next = event.target.value
+          setNested(path, next.length === 0 ? undefined : next)
+        }}
+      />
+    )
+    // A `model` field is the conventional seat for the discovery picker:
+    // harness model selectors all name it `model`. Discovery is additive —
+    // the text input above stays the source of truth and the fallback.
+    if (name === 'model') {
+      return (
+        <div className={styles['field']}>
+          {label}
+          {input}
+          {help}
+          <ModelPicker
+            probe={probe}
+            api={api}
+            t={t}
+            disabled={disabled}
+            onPick={(id) => { setNested(path, id) }}
+          />
+        </div>
+      )
+    }
+    return (
+      <div className={styles['field']}>
+        {label}
+        {input}
+        {help}
+      </div>
+    )
+  }
+
+  const choices = enumChoices(field)
+  if (choices !== undefined) {
+    const effective = typeof value === 'string' && choices.includes(value)
+      ? value
+      : typeof fallback === 'string' && choices.includes(fallback)
+        ? fallback
+        : typeof field.meta.default === 'string' && choices.includes(field.meta.default)
+          ? field.meta.default
+          : choices[0] ?? ''
+    return (
+      <div className={styles['field']}>
+        {label}
+        <select
+          className={`${styles['input']} ${styles['selectInput']}`}
+          value={effective}
+          aria-label={ariaLabel}
+          disabled={disabled || field.meta.disabled === true}
+          onChange={(event) => { setNested(path, event.target.value) }}
+        >
+          {choices.map(choice => <option key={choice} value={choice}>{choice}</option>)}
+        </select>
+      </div>
+    )
+  }
+
+  if (field.type === 'boolean') {
+    const effective = typeof value === 'boolean'
+      ? value
+      : typeof fallback === 'boolean'
+        ? fallback
+        : typeof field.meta.default === 'boolean'
+          ? field.meta.default
+          : true
+    return (
+      <div className={styles['field']}>
+        {label}
+        <select
+          className={`${styles['input']} ${styles['selectInput']}`}
+          value={effective ? 'enabled' : 'disabled'}
+          aria-label={ariaLabel}
+          disabled={disabled || field.meta.disabled === true}
+          onChange={(event) => { setNested(path, event.target.value === 'enabled') }}
+        >
+          <option value="enabled">Enabled</option>
+          <option value="disabled">Disabled</option>
+        </select>
+        {help}
+      </div>
+    )
+  }
+
+  if (field.type === 'number') {
+    const text = typeof value === 'number' ? String(value) : ''
+    const numeric = (raw: string): number | undefined => {
+      if (raw.trim().length === 0) return undefined
+      const parsed = Number(raw)
+      return Number.isFinite(parsed) ? parsed : undefined
+    }
+    return (
+      <div className={styles['field']}>
+        {label}
+        <input
+          className={styles['input']}
+          type="text"
+          inputMode="numeric"
+          value={text}
+          placeholder={typeof fallback === 'number' ? String(fallback) : String(field.meta.default ?? '')}
+          aria-label={ariaLabel}
+          disabled={disabled || field.meta.disabled === true}
+          onChange={(event) => { setNested(path, numeric(event.target.value)) }}
+        />
+        {help}
+      </div>
+    )
+  }
+
+  // field.type === 'object' (the editable branch is exhaustive above): a
+  // collapsible semantic group, with label/collapsed driven by ui metadata.
+  return (
+    <GroupShell
+      name={name}
+      field={field}
+      path={path}
+      value={value}
+      fallback={fallback}
+      setNested={setNested}
+      disabled={disabled}
+      owner={owner}
+    />
+  )
+}
+
+/**
+ * Render one object node's child fields. Boolean master switches may declare
+ * `.extra('controls', [...])` — sibling field names they disable while off;
+ * compute the effective switch values first, then the disabled targets, so
+ * rendering stays declarative.
+ */
+function objectChildren(props: {
+  field: SchemaNode
+  path: readonly string[]
+  value: unknown
+  fallback: unknown
+  setNested: (path: readonly string[], value: unknown) => void
+  disabled: boolean
+  owner: GenericSchemaEditorProps
+}): ReactNode[] {
+  const { field, path, value, fallback, setNested, disabled, owner } = props
+  const { schema } = owner
+  const disabledTargets = new Set<string>()
+  for (const [childName, child] of Object.entries(field.dict ?? {})) {
+    if (child.type !== 'boolean') continue
+    const controls = controlsOf(child)
+    if (controls === undefined) continue
+    const on = effectiveBoolean(
+      schema.getPath(value, [childName]),
+      schema.getPath(fallback, [childName]),
+      child,
+    )
+    if (!on) for (const target of controls) disabledTargets.add(target)
+  }
+  const children: ReactNode[] = []
+  for (const [childName, child] of Object.entries(field.dict ?? {})) {
+    if (child.meta.hidden === true) continue
+    const childValue = schema.getPath(value, [childName])
+    const childFallback = schema.getPath(fallback, [childName])
+    children.push(
+      <FieldEditor
+        key={childName}
+        name={childName}
+        field={child}
+        path={[...path, childName]}
+        value={childValue}
+        fallback={childFallback}
+        setNested={setNested}
+        disabled={disabled || disabledTargets.has(childName)}
+        owner={owner}
+      />,
+    )
+  }
+  return children
+}
+
+/**
+ * A semantic group: one top-level object field rendered as a collapsible
+ * section. Providers declare the group's display label and whether it starts
+ * collapsed through `.extra('extra', {ui: {label, collapsed}})` — generic,
+ * never per-family. Absent metadata keeps the current default (expanded,
+ * humanized key as label), so a provider with no UI hints renders exactly as
+ * before.
+ */
+function GroupShell(props: {
+  name: string
+  field: SchemaNode
+  path: readonly string[]
+  value: unknown
+  fallback: unknown
+  setNested: (path: readonly string[], value: unknown) => void
+  disabled: boolean
+  owner: GenericSchemaEditorProps
+}): ReactNode {
+  const ui = uiOf(props.field)
+  const label = ui?.label ?? humanize(props.name)
+  const collapsed = ui?.collapsed === true
+  return (
+    <details className={styles['customized']} open={!collapsed}>
+      <summary className={styles['customizedSummary']}>{label}</summary>
+      <div className={styles['customizedBody']}>
+        {objectChildren(props)}
+      </div>
+    </details>
+  )
+}
+
+/**
+ * Discovery-backed model picker, strictly additive: fetching asks the endpoint
+ * the form currently shows (including an unsaved base URL and key), and the
+ * reply is a list of ids the user picks from — never configuration written
+ * behind them. Failure (unreachable endpoint, no registered discovery, a
+ * rejected key) is shown next to the still-usable text field.
+ */
+function ModelPicker(props: {
+  probe: ProbeTarget
+  api: Pick<IApiClient, 'llm'>
+  t: (key: keyof typeof en) => string
+  disabled: boolean
+  onPick: (id: string) => void
+}): ReactNode {
+  const { probe, api, t, disabled, onPick } = props
+  const [busy, setBusy] = useState(false)
+  const [failure, setFailure] = useState<string | undefined>(undefined)
+  const [candidates, setCandidates] = useState<readonly { id: string }[] | undefined>(undefined)
+  const fetchModels = async (): Promise<void> => {
+    setBusy(true)
+    setFailure(undefined)
+    try {
+      const response = await api.llm.discoverModels({
+        settingsNs: probe.settingsNs,
+        ...probe.provider === undefined ? {} : { provider: probe.provider },
+        ...probe.baseURL === undefined || probe.baseURL.length === 0 ? {} : { baseURL: probe.baseURL },
+        ...probe.apiKey === undefined ? {} : { apiKey: probe.apiKey },
+      })
+      if (!response.result.ok) {
+        setFailure(response.result.error.message)
+        return
+      }
+      const found = response.result.value.models
+      if (found.length === 0) {
+        setFailure(t('fetchEmpty'))
+        return
+      }
+      setCandidates(found)
+    } catch (error) {
+      setFailure(messageOf(error))
+    } finally {
+      setBusy(false)
+    }
+  }
+  return (
+    <div className={styles['modelCatalog']}>
+      <div className={styles['modelListHead']}>
+        <span className={styles['modelCatalogTitle']}>{t('models')}</span>
+        <button
+          type="button"
+          className={styles['linkButton']}
+          disabled={disabled || busy}
+          onClick={() => { void fetchModels() }}
+        >
+          {busy ? t('fetching') : t('genericModelFetch')}
+        </button>
+      </div>
+      {candidates === undefined
+        ? null
+        : (
+          <ul className={styles['candidateList']}>
+            {candidates.map((candidate) => (
+              <li key={candidate.id} className={styles['candidate']}>
+                <button
+                  type="button"
+                  className={styles['candidateLabel']}
+                  disabled={disabled}
+                  onClick={() => {
+                    onPick(candidate.id)
+                    setCandidates(undefined)
+                  }}
+                >
+                  <span className={styles['candidateId']}>{candidate.id}</span>
+                </button>
+              </li>
+            ))}
+          </ul>
+        )}
+      {failure === undefined ? null : <p className={styles['error']}>{failure}</p>}
+    </div>
+  )
+}
+
+/**
+ * The schema-driven editor body: one field per schema key, in schema order,
+ * nested objects rendered as collapsible groups.
+ */
+export function GenericSchemaEditor(props: GenericSchemaEditorProps): ReactNode {
+  const { node, schema, draft, setDraft, fallback, disabled } = props
+  const setNested = (path: readonly string[], value: unknown): void => {
+    setDraft(current => value === undefined
+      ? schema.deletePath(current, path)
+      : schema.setPath(current, path, value))
+  }
+  if (node.type !== 'object') {
+    // A non-object section schema is not editable as fields; never drop it.
+    return <p className={styles['advancedHint']}>{props.t('genericUnsupported')}</p>
+  }
+  const fields: ReactNode[] = []
+  for (const [name, field] of Object.entries(node.dict ?? {})) {
+    if (field.meta.hidden === true) continue
+    const value = schema.getPath(draft, [name])
+    const layered = schema.getPath(fallback, [name])
+    fields.push(
+      <FieldEditor
+        key={name}
+        name={name}
+        field={field}
+        path={[name]}
+        value={value}
+        fallback={layered}
+        setNested={setNested}
+        disabled={disabled}
+        owner={props}
+      />,
+    )
+  }
+  return <>{fields}</>
+}
